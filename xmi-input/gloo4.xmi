										<property name="modelType" type="string" value="FIText"/>
										<property name="instances" type="models">
											<vpumlModels>
												<vpumlModel id="4j8cMoaGAqAmghgY" modelType="FITextInstance">
													<properties>
														<property name="name" type="string" value=""/>
														<property name="modelType" type="string" value="FITextInstance"/>
														<property htmlValue="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Information kommer i huvudsak att fl&amp;#246;da fr&amp;#229;n v&amp;#229;rdgivare till andra &#13;&#10;      v&amp;#229;rdgivare, patienten sj&amp;#228;lv och kvalitetsregister.&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;" name="documentation" type="htmlString" value="Information kommer i huvudsak att flöda från vårdgivare till andra vårdgivare, patienten själv och kvalitetsregister."/>
													</properties>
												</vpumlModel>
											</vpumlModels>
