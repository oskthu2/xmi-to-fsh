				<slot definingFeature="Y6vu0oaGAqAmgjon" name="Slot" xmi:id="2qkgnGaFYFEE_lQT" xmi:type="uml:Slot">
					<value body="{fritextkommentar till resultat}" xmi:id="2qkgnGaFYFEE_lQU" xmi:type="uml:OpaqueExpression"/>
					<xmi:Extension extender="Visual Paradigm">
						<qualityScore value="-1"/>
					</xmi:Extension>
				</slot>
				<classifier xmi:idref="w6vu0oaGAqAmgjoj"/>
