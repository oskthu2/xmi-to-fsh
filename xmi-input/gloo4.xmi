				<ownedComment annotatedElement="NmOGBoaGAqAC.w1." xmi:id="NmOGBoaGAqAC.w1._documentaiton" xmi:type="uml:Comment">
					<body>(inom hälso- och sjukvården:) humanbiologiskt material som tagits från en levande eller avliden person eller ett foster i syfte att erhålla information om den som provet härrör från (Biobanksordlistan, under rev.)&#10;Exempel på humanbiologiskt material är vävnad och kroppsvätskor som blod, urin, sekret.</body>
					<xmi:Extension extender="Visual Paradigm">
						<htmlValue value="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      (inom h&amp;#228;lso- och sjukv&amp;#229;rden:) humanbiologiskt material som tagits fr&amp;#229;n &#13;&#10;      en levande eller avliden person eller ett foster i syfte att erh&amp;#229;lla &#13;&#10;      information om den som provet h&amp;#228;rr&amp;#246;r fr&amp;#229;n (Biobanksordlistan, under rev.)&#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Exempel p&amp;#229; humanbiologiskt material &amp;#228;r v&amp;#228;vnad och kroppsv&amp;#228;tskor som &#13;&#10;      blod, urin, sekret.&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;"/>
					</xmi:Extension>
				</ownedComment>
			</ownedMember>
