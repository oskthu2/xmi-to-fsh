					</vpumlChildModelRefs>
					<vpumlChildModels>
						<vpumlModel id="ce5sg8aGAqAiISgN" modelType="BPStartEvent">
							<properties>
								<property name="name" type="string" value="Start"/>
								<property name="modelType" type="string" value="BPStartEvent"/>
								<property htmlValue="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 12px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Start f&amp;#246;r arbetsfl&amp;#246;det.&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;" name="documentation" type="htmlString" value="Start för arbetsflödet."/>
								<property name="pmAuthor" type="string" value="torbjorn.dahlin@medmod.se"/>
								<property name="pmCreateDateTime" type="string" value="1527954962332"/>
								<property name="pmLastModified" type="string" value="1527959811880"/>
								<property name="userID" type="string" value="BP92"/>
								<property name="userIDLastNumericValue" type="int" value="0"/>
