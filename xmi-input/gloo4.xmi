														<property htmlValue="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Ja, samtliga av dessa hanteras.&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;" name="documentation" type="htmlString" value="Ja, samtliga av dessa hanteras."/>
