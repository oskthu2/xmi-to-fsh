					<lowerValue value="0" xmi:id="EGvu0oaGAqAmgjpZ_multiplicity_lowerValue" xmi:type="uml:LiteralString"/>
					<upperValue value="1" xmi:id="EGvu0oaGAqAmgjpZ_multiplicity_upperValue" xmi:type="uml:LiteralString"/>
					<ownedComment annotatedElement="EGvu0oaGAqAmgjpZ" xmi:id="EGvu0oaGAqAmgjpZ_documentaiton" xmi:type="uml:Comment">
						<body>Angivelse av datum och eventuell tidpunkt då patienten är född.&#10;&#10;Ska användas om patienten inte har personnummer samt i vissa fall för spädbarn. Om fullständigt födelsedatum inte är känt, anges uppskattad födelsetid. Exakt klockslag kan vara intressant för nyfödda barn, men formatet tillåter lägre precision:&#10;Format: SSÅÅMMDDThhmmss, SSÅÅMMDDThhmm, SSÅÅMMDD, SSÅÅMM</body>
						<xmi:Extension extender="Visual Paradigm">
							<htmlValue value="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Angivelse av datum och eventuell tidpunkt d&amp;#229; patienten &amp;#228;r f&amp;#246;dd.&#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      &#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Ska anv&amp;#228;ndas om patienten inte har personnummer samt i vissa fall f&amp;#246;r &#13;&#10;      sp&amp;#228;dbarn. Om fullst&amp;#228;ndigt f&amp;#246;delsedatum inte &amp;#228;r k&amp;#228;nt, anges uppskattad &#13;&#10;      f&amp;#246;delsetid. Exakt klockslag kan vara intressant f&amp;#246;r nyf&amp;#246;dda barn, men &#13;&#10;      formatet till&amp;#229;ter l&amp;#228;gre precision:&#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Format: SS&amp;#197;&amp;#197;MMDDThhmmss, SS&amp;#197;&amp;#197;MMDDThhmm, SS&amp;#197;&amp;#197;MMDD, SS&amp;#197;&amp;#197;MM&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;"/>
						</xmi:Extension>
					</ownedComment>
				</ownedAttribute>
