					<ownedComment annotatedElement="If3DnoaGAqAktw5E" xmi:id="If3DnoaGAqAktw5E_documentaiton" xmi:type="uml:Comment">
						<body>Angivelse av personnamn sammanslaget enligt formatet &quot;Mellannamn Efternamn, Förnamn&quot;.&#10;&#10;Om flera namn av samma typ förekommer ska dessa separeras med mellanslag.</body>
						<xmi:Extension extender="Visual Paradigm">
							<htmlValue value="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Angivelse av personnamn sammanslaget enligt formatet &amp;quot;Mellannamn &#13;&#10;      Efternamn, F&amp;#246;rnamn&amp;quot;.&#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      &#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Om flera namn av samma typ f&amp;#246;rekommer ska dessa separeras med mellanslag.&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;"/>
						</xmi:Extension>
					</ownedComment>
				</ownedAttribute>
