								<vpumlModel id="3r8cMoaGAqAmghgv" modelType="FIText">
									<properties>
										<property name="name" type="string" value="Begreppsmodellstext"/>
										<property name="modelType" type="string" value="FIText"/>
										<property name="instances" type="models">
											<vpumlModels>
												<vpumlModel id="Kb8cMoaGAqAmghgw" modelType="FITextInstance">
													<properties>
														<property name="name" type="string" value=""/>
