					<body>Utökade attribut för analysutrustning.&#10;Möjlighet för mottagare att signera enskilda resultat förutom hela svaret&#10;Ändrad kardinalitet på signatur från ansvarig för svar.</body>
					<xmi:Extension extender="Visual Paradigm">
						<htmlValue value="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Ut&amp;#246;kade attribut f&amp;#246;r analysutrustning.&#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      M&amp;#246;jlighet f&amp;#246;r mottagare att signera enskilda resultat f&amp;#246;rutom hela svaret&#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      &amp;#196;ndrad kardinalitet p&amp;#229; signatur fr&amp;#229;n ansvarig f&amp;#246;r svar.&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;"/>
					</xmi:Extension>
				</ownedComment>
			</ownedAttribute>
