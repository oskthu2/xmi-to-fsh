				<ownedComment annotatedElement="ssyiBoaGAqAC.wv." xmi:id="ssyiBoaGAqAC.wv._documentaiton" xmi:type="uml:Comment">
					<body>Den grupp man jämför med målpopulationen.&#10;&#10;Referenspopulationen måste stämma överens med målpopulationen i fråga om ålder, kön och sådana saker som spelar roll i sammanhanget.</body>
					<xmi:Extension extender="Visual Paradigm">
						<htmlValue value="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Den grupp man j&amp;#228;mf&amp;#246;r med m&amp;#229;lpopulationen.&#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      &#13;&#10;    &lt;/p&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      Referenspopulationen m&amp;#229;ste st&amp;#228;mma &amp;#246;verens med m&amp;#229;lpopulationen i fr&amp;#229;ga om &#13;&#10;      &amp;#229;lder, k&amp;#246;n och s&amp;#229;dana saker som spelar roll i sammanhanget.&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;"/>
					</xmi:Extension>
				</ownedComment>
			</ownedMember>
