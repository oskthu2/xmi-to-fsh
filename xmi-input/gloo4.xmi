						<htmlValue value="&lt;head&gt;&#13;&#10;    &lt;style type=&quot;text/css&quot;&gt;&#10;      &lt;!--&#10;        body { color: #000000; font-family: Dialog; font-size: 11px }&#10;      --&gt;&#10;    &lt;/style&gt;&#13;&#10;    &#13;&#10;  &lt;/head&gt;&#13;&#10;  &lt;body&gt;&#13;&#10;    &lt;p&gt;&#13;&#10;      En instans av typen Resultat SIR anv&amp;#228;nds f&amp;#246;r att dokumentera resultatet &#13;&#10;      av en best&amp;#228;mning av en mikroorganisms k&amp;#228;nslighet f&amp;#246;r en viss typ av &#13;&#10;      antimikrobiella l&amp;#228;kemedel, exempelvis en pneumokockbakteries k&amp;#228;nslighet &#13;&#10;      f&amp;#246;r Penicillin V. Med SIR avses den ordinalskala som k&amp;#228;nsligheten anges &#13;&#10;      p&amp;#229; (S - susceptible/k&amp;#228;nslig, I - intermidiate/intermedi&amp;#228;r, R - &#13;&#10;      resistant/resistent).&#13;&#10;    &lt;/p&gt;&#13;&#10;  &lt;/body&gt;"/>
					</xmi:Extension>
				</ownedComment>
			</ownedMember>
