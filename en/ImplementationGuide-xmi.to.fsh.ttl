       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Analysgrupp" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Grupp av analyser utförda på ett eller flera prov från samma provgivare och som man väljer att betrakta som en enhet." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
