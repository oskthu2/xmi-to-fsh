       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Hälso- och sjukvårdspersonal : Hälso- och sjukvårdspersonal" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Klassen hälso- och sjukvårdspersonal håller information om person som i sitt yrke utför hälso- och sjukvård.\nHälso- och sjukvårdspersonal är oftast anställd av en vårdgivare. En vårdgivare kan ha anställd hälso- och sjukvårdspersonal, och ibland, som till exempel för enskild näringsidkare, kan rollerna sammanfalla." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
