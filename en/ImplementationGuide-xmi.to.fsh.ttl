         fhir:link <http://example.org/fhir/xmi-to-fsh/StructureDefinition/Analysgrupp> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/Analysgrupp" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Analysgrupp" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Klassen Analysgrupp grupperar ett antal analyser som utförs på ett eller flera prov från samma patient och som man väljer att betrakta som en enhet." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
